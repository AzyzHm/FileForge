NODE_ENV=development

PORT=3000

CORS_ORIGIN=http://localhost:5173/

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

MAX_UPLOAD_BYTES=52428800

# Optional. Absolute path to the LibreOffice/soffice binary. Leave unset to
# use the OS-default install locations libreoffice-convert already checks.
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
# Linux (Cloud Run) example: /usr/bin/soffice
LIBREOFFICE_BIN_PATH=

# Milliseconds to allow a single LibreOffice conversion before it is killed
LIBREOFFICE_TIMEOUT_MS=60000

# Optional. Absolute path to the Ghostscript binary. Leave unset to invoke
# the OS-default command name via PATH ("gs" on Linux/macOS, "gswin64c" then
# "gswin32c" on Windows).
# Windows installs Ghostscript into a version-numbered folder and does not
# always add it to PATH, so this usually needs to be set explicitly, e.g.
# C:\Program Files\gs\gs10.05.0\bin\gswin64c.exe (adjust to your installed version)
# Linux (Cloud Run) example: /usr/bin/gs
GHOSTSCRIPT_BIN_PATH=

# Milliseconds to allow a single Ghostscript conversion before it is killed
GHOSTSCRIPT_TIMEOUT_MS=60000